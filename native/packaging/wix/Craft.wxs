<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Windows installer for Craft (PK-2, docs/native-migration/PACKAGING.md). WiX Toolset 3.14, built by scripts/native/build-installer.ps1, which
  harvests the installed layout (Craft-install) into Files.wxs and passes the product version as $(var.Version).

  What it does:
    * Per-user install (no administrator rights) to %LocalAppData%\Programs\Craft. The folder can be changed on the command line
      (msiexec /i Craft.msi INSTALLFOLDER=D:\Apps\Craft) and nothing else changes.
    * A Start-menu shortcut, an entry in Settings > Apps (Programs and Features) with an uninstaller, and the .craft file association for
      the current user: opening a .craft file starts "Craft.exe <file>", which opens it.
    * Upgrade: the same UpgradeCode with a higher ProductVersion replaces the installed version (MajorUpgrade); an older or equal version is
      refused. The product code is new for every build, as a major upgrade requires.
    * Uninstall removes exactly what the installer put down. The user's own data is never touched: .craft projects, autosaves and recovery
      files and the analysis model cache live outside the install folder (AppPaths) and are not part of the MSI.
  No licence text is shown and no EULA is accepted here: the licence decisions (R-License-1) belong to the owner. The MSI is not signed
  (needs the owner's certificate).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Craft" Language="1033" Version="$(var.Version)" Manufacturer="Craft"
           UpgradeCode="E72749E2-3C22-4862-A127-680B5AFE6BB6">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Description="Craft: mold design for 3D-printed parts"
             Comments="Per-user installation; no administrator rights needed." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Craft is already installed. Uninstall it first to install this older version."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPCOMMENTS" Value="Craft" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder_User" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Craft" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StartMenuCraftFolder" Name="Craft" />
      </Directory>
    </Directory>

    <!-- The Start-menu shortcut. A per-user component needs a registry key path under HKCU (ICE38). -->
    <DirectoryRef Id="StartMenuCraftFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="CraftShortcut" Name="Craft" Description="Craft: mold design for 3D-printed parts"
                  Target="[INSTALLFOLDER]Craft.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuCraftFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Craft\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- The .craft association, for the current user only (HKCU\Software\Classes), written and removed with the component. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CraftFileAssociation" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Classes\.craft">
          <RegistryValue Type="string" Value="Craft.Project" />
          <RegistryValue Type="string" Name="Content Type" Value="application/x-craft-project" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Craft.Project">
          <RegistryValue Type="string" Value="Craft project" />
          <RegistryValue Type="string" Name="FriendlyTypeName" Value="Craft project" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Craft.Project\DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]Craft.exe,0" />
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Craft.Project\shell\open\command">
          <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Craft.exe&quot; &quot;%1&quot;" KeyPath="yes" />
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Craft\Installer" Name="FileAssociation" Type="integer" Value="1" />
      </Component>
    </DirectoryRef>

    <Feature Id="CraftApplication" Title="Craft" Level="1" Absent="disallow">
      <ComponentGroupRef Id="CraftFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="CraftFileAssociation" />
    </Feature>
  </Product>
</Wix>

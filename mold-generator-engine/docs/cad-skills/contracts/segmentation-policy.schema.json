{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SegmentationPolicy",
  "description": "Versioned priorities and decision rules for the General Segmentation Engine. The engine owns the reasoning procedure; this policy owns objectives, thresholds, weighting, uncertainty treatment, and tie-breaking.",
  "type": "object",
  "required": [
    "policyId",
    "policyVersion",
    "revision",
    "providerId",
    "components",
    "aggregation",
    "tieBreakers",
    "requiredEvidence",
    "invalidationTriggers"
  ],
  "properties": {
    "policyId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "componentId",
          "role",
          "applicability",
          "objectives",
          "uncertaintyTreatment",
          "requiredValidation"
        ],
        "properties": {
          "componentId": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Open role identifier, for example production, structural, quality, cost, time, assembly, risk, or validation."
          },
          "applicability": { "type": "string", "minLength": 1 },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "metricId",
                "objectiveKind",
                "normalizationMethod",
                "priority",
                "valueSource"
              ],
              "properties": {
                "metricId": { "type": "string", "minLength": 1 },
                "objectiveKind": {
                  "type": "string",
                  "enum": ["HARD_CONSTRAINT", "SOFT_OBJECTIVE", "ADVISORY"]
                },
                "normalizationMethod": { "type": "string", "minLength": 1 },
                "priority": { "type": "number", "minimum": 0 },
                "valueSource": { "type": "string", "minLength": 1 },
                "rejectionThreshold": {},
                "warningThreshold": {}
              }
            }
          },
          "uncertaintyTreatment": {
            "type": "object",
            "required": ["method", "penaltySource"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "penaltySource": { "type": "string", "minLength": 1 }
            }
          },
          "requiredValidation": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "aggregation": {
      "type": "object",
      "required": ["method", "weightSource", "riskPenaltySource"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "weightSource": { "type": "string", "minLength": 1 },
        "riskPenaltySource": { "type": "string", "minLength": 1 }
      }
    },
    "tieBreakers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "invalidationTriggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
